MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/terratoken

# JWT Secret
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=1d

# Blockchain Configuration
ALCHEMY_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/your_api_key
PRIVATE_KEY=your_private_key
CARBON_CREDIT_ADDRESS=your_carbon_credit_contract_address
MARKETPLACE_ADDRESS=0x456...
VERIFICATION_ADDRESS=your_verification_contract_address

# IPFS Configuration
IPFS_API_URL=https://ipfs.infura.io:5001/api/v0
INFURA_IPFS_PROJECT_ID=your_infura_project_id
INFURA_IPFS_PROJECT_SECRET=your_infura_project_secret

# Email Service
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@terratoken.io

# Server Configuration
PORT=5000
NODE_ENV=development

# For production only
# CORS_ORIGIN=https://terratoken.io